{
  "name": "tagteam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file=.env server.mjs\" \"vite\"",
    "dev:api": "node --env-file=.env server.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "render-audio": "node --env-file=.env scripts/render-scenario-audio.mjs",
    "preview": "vite preview",
    "start": "node --env-file=.env server.mjs"
  },
  "dependencies": {
