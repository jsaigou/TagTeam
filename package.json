    "better-auth": "^1.6.29",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.29.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@perxona/presenter-types": "0.2.0",
