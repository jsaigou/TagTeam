# Copy to .env and fill in real values. NEVER commit .env — it is git-ignored.
# Only this file (.env.example) with placeholders is committed.

# --- Auth & database ---
# better-auth signing secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public base URL for the app (used for auth callbacks/links). Optional.
# BETTER_AUTH_URL=http://localhost:8083
# Path to the SQLite database file (defaults to ./data/tagteam.db).
# DATABASE_PATH=./data/tagteam.db
# Comma-separated extra origins allowed for auth (e.g. a Tailscale name).
# TRUSTED_ORIGINS=

# --- Server-side (server.mjs) ---
# Perxona Connect API base (region-specific)
PERXONA_API_BASE_URL=https://console.perxona.ai/asia
# The one shared Connect identity used to mint tokens for all visitors
PERXONA_CONNECT_EMAIL=
PERXONA_CONNECT_PASSWORD=
PORT=8083
# <sv-presenter> engine CDN URL (region-specific). Optional — defaults to the asia channel.
# PRESENTER_URL=
# Opt into the unauthenticated /api/demo/* endpoints (the /demo avatar-effects
# sandbox) even in production. Off by default in prod (NODE_ENV=production);
# always on in dev. Do NOT enable on a public deployment.
# ENABLE_DEMO_API=1

# --- LLM (server-side; the app proxies /api/llm so the key never reaches the browser) ---
# Any OpenAI-compatible endpoint (OpenAI, Ollama, LM Studio…); the model must
# support response_format json_object. `LLM_PROVIDER` may be "openai" (default)
# or "anthropic".
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai

# --- Live-conversation brain (Phase 5d, server-side) ---
# Which backend generates the adaptive bureaucrat reply during a call.
#   NEXTTURN_PROVIDER=own-llm          (default — the LLM above)
#   NEXTTURN_PROVIDER=connect-chatbot  (a Connect Chatbot — sponsor showcase)
# The chatbot's custom_instructions hold the persona (see SETUP.md §connect);
# create one and paste its id here.
# CHATBOT_ID=

# --- Reference search (optional, see SETUP.md) ---
# Provide your own search + scrape endpoints. Leave empty to disable the
# "Research the office" step (the app works without it).
# SEARXNG_URL=https://your-searxng.example.com
# FIRECRAWL_URL=https://your-firecrawl.example.com
# FIRECRAWL_API_KEY=            # required for Firecrawl cloud (api.firecrawl.dev); self-hosted usually needs none
# SEARCH_LANGUAGE=ja-JP         # geo-scoping for search results (defaults to ja-JP)

# --- Speech-to-text (Phase 3, server-side) ---
# STT_PROVIDER=whisper-cpp     # whisper-cpp (default) | hosted
# whisper.cpp CLI — `brew install whisper-cpp` puts `whisper-cli` on PATH.
# WHISPER_BIN=whisper-cli
# Model name or path. whisper.cpp does NOT auto-download; grab the multilingual
# base model once (see SETUP.md):
#   mkdir -p data/models && curl -L -o data/models/ggml-base.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin
# WHISPER_MODEL=ggml-base.bin
# STT_LANGUAGE=ja               # scenario language (defaults to ja)
# Hosted OpenAI-compatible alternative (STT_PROVIDER=hosted):
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1

# --- Text-to-speech (Phase 5f, server-side; avatar BYO speech) ---
# TTS_PROVIDER=byo              # avatar speaks via your own TTS engine
# Any OpenAI-compatible /audio/speech endpoint (kokoro, qwen, Edge-TTS gateways…):
# TTS_BASE_URL=https://your-tts.example.com/v1
# TTS_API_KEY=
# TTS_MODEL=kokoro
# TTS_VOICE=af_heart           # optional engine voice id
# TTS_LANGUAGE=ja
# TTS_NORMALIZE=1              # resample to 16 kHz mono WAV via ffmpeg (default; the presenter's verified codec)

# --- Client-side (Vite, exposed to the browser) ---
# <sv-presenter> engine CDN URL; empty auto-discovers via the default region channel.
VITE_PRESENTER_URL=
# LLM model id sent to the server proxy (non-secret).
VITE_LLM_MODEL=gpt-4o-mini
# Document scan engine CDN URL. Empty uses the docs.opencv.org default. Set to
# a local/vendored copy for offline use (see SETUP.md).
# VITE_OPENCV_URL=https://docs.opencv.org/4.10.0/opencv.js
# Voice-activated talk (Silero VAD) asset CDN roots. Empty uses jsdelivr
# defaults pinned to the installed @ricky0123/vad-web / onnxruntime-web
# versions. Set both to local/vendored copies for offline use (see SETUP.md).
#   VITE_SILERO_VAD_URL=https://cdn.jsdelivr.net/npm/@ricky0123/vad-web@0.0.30/dist/
#   VITE_SILERO_VAD_WASM_URL=https://cdn.jsdelivr.net/npm/onnxruntime-web@1.27.0/dist/
# Avatar speech path (must match TTS_PROVIDER on the server):
#   VITE_TTS_PROVIDER=perxona   (default — built-in Perxona voices)
#   VITE_TTS_PROVIDER=byo       (server-side BYO TTS via presentWithAudio)
