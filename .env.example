# Copy to .env and fill in real values. NEVER commit .env — it is git-ignored.
# Only this file (.env.example) with placeholders is committed.

# Perxona Connect API base (region-specific)
VITE_PERXONA_API_BASE_URL=https://console.perxona.ai/asia

# <sv-presenter> engine CDN URL. Leave blank to auto-discover via the Connect API getConfig().
VITE_PRESENTER_URL=

# OpenAI-compatible LLM (OpenAI, Ollama, LM Studio, etc.)
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_API_KEY=
VITE_LLM_MODEL=gpt-4o-mini
